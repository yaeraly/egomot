# Copy this file to apps/api/.env
#
# Docker Compose Postgres (recommended): port 5433
DATABASE_URL=postgresql://egomot:egomot@localhost:5433/egomot?schema=public
#
# If you use an existing local PostgreSQL on 5432 instead, either:
#   1) create the egomot user (see scripts/create-local-postgres.sh)
#   2) or put your own credentials here, for example:
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/egomot?schema=public

JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
OWNER_EMAIL=owner@egomot.local
OWNER_PASSWORD=Owner123!
PORT=3001
WEB_ORIGIN=http://localhost:3000

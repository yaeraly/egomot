generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  WAREHOUSE
}

enum PurchaseStatus {
  DRAFT
  ORDERED
  PAID
  IN_CHINA_TRANSIT
  HANDED_TO_CARGO
  IN_TRANSIT_TO_KYRGYZSTAN
  ARRIVED
  RECEIVED
  RECEIVED_WITH_DISCREPANCY
}

enum PurchaseReceiptStatus {
  DRAFT
  RECEIVING
  COMPLETED
  CANCELLED
}

enum ReceiptDiscrepancyType {
  SHORTAGE
  EXCESS
}

enum InventoryMovementType {
  PURCHASE_RECEIPT
}

enum InventoryReferenceType {
  PURCHASE_RECEIPT
}

enum LogisticsType {
  CHINA_INTERNAL_TRANSPORT
  CARGO
  KYRGYZSTAN_INTERNAL_TRANSPORT
  OTHER
}

enum Currency {
  CNY
  KGS
  USD
}

model User {
  id                 String              @id @default(uuid())
  email              String              @unique
  passwordHash       String
  name               String
  role               UserRole            @default(OWNER)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  auditLogs          AuditLog[]
  purchaseReceipts   PurchaseReceipt[]
  inventoryMovements InventoryMovement[]

  @@index([role])
}

model Category {
  id        String    @id @default(uuid())
  name      String    @unique
  slug      String    @unique
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]

  @@index([isActive])
  @@index([slug])
  @@map("Category")
}

model Product {
  id                      String   @id @default(uuid())
  code                    String   @unique
  name                    String   @unique
  categoryId              String
  category                Category @relation(fields: [categoryId], references: [id])
  unit                    String
  imageUrl                String?
  unitWeightKg            Decimal  @db.Decimal(12, 3)
  defaultPurchasePriceCny Decimal? @db.Decimal(12, 2)
  isActive                Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  purchaseItems                 PurchaseItem[]
  inventory                     Inventory?
  inventoryMovements            InventoryMovement[]
  purchaseReceiptItems          PurchaseReceiptItem[]
  purchaseReceiptDiscrepancies  PurchaseReceiptDiscrepancy[]

  @@index([name])
  @@index([isActive])
  @@index([categoryId])
  @@index([code])
}

model Supplier {
  id          String     @id @default(uuid())
  name        String
  companyName String?
  phone       String
  wechat      String?
  address     String?
  city        String?
  notes       String?
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  purchases        Purchase[]
  purchaseReceipts PurchaseReceipt[]

  @@index([name])
  @@index([isActive])
  @@index([phone])
}

model Purchase {
  id                            String        @id @default(uuid())
  number                        String        @unique
  supplierId                    String
  supplier                      Supplier      @relation(fields: [supplierId], references: [id])
  status                        PurchaseStatus @default(DRAFT)
  exchangeRateCnyToKgs          Decimal       @db.Decimal(14, 6)
  notes                         String?

  totalPositions                Int           @default(0)
  totalQuantity                 Decimal       @default(0) @db.Decimal(14, 3)
  totalWeightKg                 Decimal       @default(0) @db.Decimal(14, 3)
  totalPurchaseCny              Decimal       @default(0) @db.Decimal(14, 2)
  totalPurchaseCostKgs          Decimal       @default(0) @db.Decimal(14, 2)
  totalChinaTransportKgs        Decimal       @default(0) @db.Decimal(14, 2)
  totalCargoKgs                 Decimal       @default(0) @db.Decimal(14, 2)
  totalKgInternalTransportKgs   Decimal       @default(0) @db.Decimal(14, 2)
  totalOtherLogisticsKgs        Decimal       @default(0) @db.Decimal(14, 2)
  totalLogisticsKgs             Decimal       @default(0) @db.Decimal(14, 2)
  estimatedTotalLandedCostKgs   Decimal       @default(0) @db.Decimal(14, 2)
  averageLogisticsCostPerKg     Decimal       @default(0) @db.Decimal(14, 4)

  createdAt                     DateTime      @default(now())
  updatedAt                     DateTime      @updatedAt

  items                         PurchaseItem[]
  logistics                     PurchaseLogisticsExpense[]
  receipts                      PurchaseReceipt[]

  @@index([status])
  @@index([supplierId])
  @@index([createdAt])
  @@index([number])
}

model PurchaseItem {
  id                              String   @id @default(uuid())
  purchaseId                      String
  purchase                        Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId                       String
  product                         Product  @relation(fields: [productId], references: [id])

  quantity                        Decimal  @db.Decimal(14, 3)
  unitPriceCny                    Decimal  @db.Decimal(14, 4)
  totalCny                        Decimal  @db.Decimal(14, 2)
  unitWeightKg                    Decimal  @db.Decimal(14, 3)
  totalWeightKg                   Decimal  @db.Decimal(14, 3)
  exchangeRateCnyToKgs            Decimal  @db.Decimal(14, 6)
  purchaseCostKgs                 Decimal  @db.Decimal(14, 2)

  allocatedChinaTransportKgs      Decimal  @default(0) @db.Decimal(14, 2)
  allocatedCargoKgs               Decimal  @default(0) @db.Decimal(14, 2)
  allocatedKgInternalTransportKgs Decimal  @default(0) @db.Decimal(14, 2)
  allocatedOtherLogisticsKgs      Decimal  @default(0) @db.Decimal(14, 2)
  totalAllocatedLogisticsKgs      Decimal  @default(0) @db.Decimal(14, 2)
  estimatedLandedCostKgs          Decimal  @default(0) @db.Decimal(14, 2)
  estimatedUnitLandedCostKgs      Decimal  @default(0) @db.Decimal(14, 4)

  createdAt                       DateTime @default(now())
  updatedAt                       DateTime @updatedAt
  receiptItems                    PurchaseReceiptItem[]

  @@unique([purchaseId, productId])
  @@index([purchaseId])
  @@index([productId])
}

model Inventory {
  id                 String   @id @default(uuid())
  productId          String   @unique
  product            Product  @relation(fields: [productId], references: [id])
  quantity           Decimal  @default(0) @db.Decimal(14, 3)
  averageUnitCostKgs Decimal  @default(0) @db.Decimal(14, 4)
  totalValueKgs      Decimal  @default(0) @db.Decimal(14, 2)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([productId])
}

model InventoryMovement {
  id               String                  @id @default(uuid())
  type             InventoryMovementType
  productId        String
  product          Product                 @relation(fields: [productId], references: [id])
  quantity         Decimal                 @db.Decimal(14, 3)
  previousQuantity Decimal                 @db.Decimal(14, 3)
  newQuantity      Decimal                 @db.Decimal(14, 3)
  unitCost         Decimal                 @db.Decimal(14, 4)
  totalCost        Decimal                 @db.Decimal(14, 2)
  referenceType    InventoryReferenceType
  referenceId      String
  userId           String
  user             User                    @relation(fields: [userId], references: [id])
  createdAt        DateTime                @default(now())

  @@index([productId])
  @@index([referenceType, referenceId])
  @@index([userId])
  @@index([createdAt])
}

model PurchaseReceipt {
  id                             String                @id @default(uuid())
  number                         String                @unique
  purchaseId                     String
  purchase                       Purchase              @relation(fields: [purchaseId], references: [id])
  supplierId                     String
  supplier                       Supplier              @relation(fields: [supplierId], references: [id])
  arrivalDate                    DateTime              @db.Date
  receivedByUserId               String
  receivedBy                     User                  @relation(fields: [receivedByUserId], references: [id])
  status                         PurchaseReceiptStatus @default(DRAFT)
  comment                        String?
  exchangeRateCnyToKgs           Decimal               @db.Decimal(14, 6)
  chinaInternalTransportKgs      Decimal               @default(0) @db.Decimal(14, 2)
  cargoKgs                       Decimal               @default(0) @db.Decimal(14, 2)
  kyrgyzstanInternalTransportKgs Decimal               @default(0) @db.Decimal(14, 2)
  totalTransportKgs              Decimal               @default(0) @db.Decimal(14, 2)
  totalOrderedQuantity           Decimal               @default(0) @db.Decimal(14, 3)
  totalReceivedQuantity          Decimal               @default(0) @db.Decimal(14, 3)
  totalDifference                Decimal               @default(0) @db.Decimal(14, 3)
  totalLandedCostKgs             Decimal               @default(0) @db.Decimal(14, 2)
  createdAt                      DateTime              @default(now())
  updatedAt                      DateTime              @updatedAt
  items                          PurchaseReceiptItem[]
  discrepancies                  PurchaseReceiptDiscrepancy[]

  @@index([purchaseId])
  @@index([status])
  @@index([supplierId])
  @@index([arrivalDate])
  @@index([number])
}

model PurchaseReceiptItem {
  id                              String          @id @default(uuid())
  receiptId                       String
  receipt                         PurchaseReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  purchaseItemId                  String
  purchaseItem                    PurchaseItem    @relation(fields: [purchaseItemId], references: [id])
  productId                       String
  product                         Product         @relation(fields: [productId], references: [id])
  orderedQuantity                 Decimal         @db.Decimal(14, 3)
  receivedQuantity                Decimal         @default(0) @db.Decimal(14, 3)
  difference                      Decimal         @default(0) @db.Decimal(14, 3)
  unitPriceCny                    Decimal         @db.Decimal(14, 4)
  unitWeightKg                    Decimal         @db.Decimal(14, 3)
  totalWeightKg                   Decimal         @default(0) @db.Decimal(14, 3)
  purchaseCostKgs                 Decimal         @default(0) @db.Decimal(14, 2)
  allocatedChinaTransportKgs      Decimal         @default(0) @db.Decimal(14, 2)
  allocatedCargoKgs               Decimal         @default(0) @db.Decimal(14, 2)
  allocatedKgInternalTransportKgs Decimal         @default(0) @db.Decimal(14, 2)
  totalAllocatedTransportKgs      Decimal         @default(0) @db.Decimal(14, 2)
  unitLandedCostKgs               Decimal         @default(0) @db.Decimal(14, 4)
  totalLandedCostKgs              Decimal         @default(0) @db.Decimal(14, 2)
  createdAt                       DateTime        @default(now())
  updatedAt                       DateTime        @updatedAt

  @@unique([receiptId, productId])
  @@index([receiptId])
  @@index([productId])
}

model PurchaseReceiptDiscrepancy {
  id               String                 @id @default(uuid())
  receiptId        String
  receipt          PurchaseReceipt        @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  productId        String
  product          Product                @relation(fields: [productId], references: [id])
  orderedQuantity  Decimal                @db.Decimal(14, 3)
  receivedQuantity Decimal                @db.Decimal(14, 3)
  difference       Decimal                @db.Decimal(14, 3)
  type             ReceiptDiscrepancyType
  comment          String?
  createdAt        DateTime               @default(now())

  @@index([receiptId])
  @@index([productId])
}

model PurchaseLogisticsExpense {
  id           String        @id @default(uuid())
  purchaseId   String
  purchase     Purchase      @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  type         LogisticsType
  amount       Decimal       @db.Decimal(14, 2)
  currency     Currency
  exchangeRate Decimal?      @db.Decimal(14, 6)
  amountKgs    Decimal       @db.Decimal(14, 2)
  comment      String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([purchaseId])
  @@index([type])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  action     String
  entityType String
  entityId   String
  oldValue   Json?
  newValue   Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
  @@index([action])
}
